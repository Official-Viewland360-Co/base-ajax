# ───────────────────────────────────────────────────────────────────────────────
# BaseAjax — .gitattributes
# یکسان‌سازی پایان خط و علامت‌گذاری فایل‌های دودویی
# ───────────────────────────────────────────────────────────────────────────────

# متن‌ها در مخزن و در working tree همیشه LF باشند
* text=auto eol=lf

# اسکریپت‌های شل (hooks) حتماً LF
*.sh text eol=lf
.husky/* text eol=lf

# فایل‌های دودویی دست نخورند
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
